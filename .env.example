# Server
PORT=4000
# Public URL of this API. Used to build absolute image URLs with the local
# storage driver, so set it in production (e.g. https://api.example.com).
PUBLIC_BASE_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/going-app

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Image storage: leave empty (or "local") for disk, "cloudinary" for Cloudinary.
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments
# "paystack" (default) uses the live API and needs PAYSTACK_SECRET_KEY.
# "flutterwave" uses the Flutterwave API and needs the FLUTTERWAVE_* keys.
# "mock" runs the full flow locally without provider keys or real charges.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
# Optional override of the Paystack API host (sandbox/testing only).
PAYSTACK_BASE_URL=
# Register POST /webhooks/paystack in the Paystack dashboard. Paystack signs
# the raw request body with PAYSTACK_SECRET_KEY (x-paystack-signature).
# Optional fallback: where the buyer returns after checkout when the mobile
# client does not send its own returnUrl. Defaults to
# PUBLIC_BASE_URL/payment/return. Use goingweb://payment/return for the app.
PAYMENT_REDIRECT_URL=

# Flutterwave (only when PAYMENT_PROVIDER=flutterwave)
FLUTTERWAVE_SECRET_KEY=
# The value Flutterwave sends in the verif-hash header on every webhook.
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_REDIRECT_URL=
