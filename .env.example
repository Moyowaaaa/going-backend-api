# Server
PORT=4000
# Public URL of this API. Used to build absolute image URLs with the local
# storage driver, so set it in production (e.g. https://api.example.com).
PUBLIC_BASE_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/going-app

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Image storage: leave empty (or "local") for disk, "cloudinary" for Cloudinary.
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
