//TicketType Model
model TicketType {
   id          String  @id @default(uuid())
   name String?
   description String
   price Int
   quantity Int
   currency    String  @default("NGN")
   sold        Int     @default(0)
 salesStart  DateTime?
  salesEnd    DateTime?
  eventId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


//Catgeory model
model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique
}